						<Enabled>true</Enabled>
						<ActionCode><![CDATA[vistaAnimacionActiva = false;
cardA.setVisible(true);
cardHeadA.setVisible(true);
tituloA.setVisible(true);
policyA.setVisible(true);
mA0.setVisible(true);
