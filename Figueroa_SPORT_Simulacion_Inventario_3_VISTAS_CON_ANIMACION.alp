						</Timeout>
						<Rate Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="RateUnits"><![CDATA[PER_DAY]]></Unit>
						</Rate>
						<Id>1793413627360</Id>
						<OccurrenceAtTime>true</OccurrenceAtTime>
						<OccurrenceDate>1793433600000</OccurrenceDate>
						<OccurrenceTime Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="TimeUnits"><![CDATA[DAY]]></Unit>
						</OccurrenceTime>
						<RecurrenceCode Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="TimeUnits"><![CDATA[DAY]]></Unit>
						</RecurrenceCode>
						<Condition><![CDATA[false]]></Condition>
					</Properties>
					<Action><![CDATA[// FIGUEROA SPORT - SIMULACION COMPARATIVA DE POLITICAS (s,Q)
// Una misma demanda diaria se aplica a las tres politicas para hacer una comparacion controlada.

// Vista inicial compatible con AnyLogic 8.9.10
if (diasSimulados == 0) {
    cardA.setVisible(true); cardHeadA.setVisible(true); tituloA.setVisible(true); policyA.setVisible(true);
    mA0.setVisible(true); mA1.setVisible(true); mA2.setVisible(true); mA3.setVisible(true); mA4.setVisible(true); mA5.setVisible(true);
    cardB.setVisible(true); cardHeadB.setVisible(true); tituloB.setVisible(true); policyB.setVisible(true);
    mB0.setVisible(true); mB1.setVisible(true); mB2.setVisible(true); mB3.setVisible(true); mB4.setVisible(true); mB5.setVisible(true);
    cardC.setVisible(true); cardHeadC.setVisible(true); tituloC.setVisible(true); policyC.setVisible(true);
    mC0.setVisible(true); mC1.setVisible(true); mC2.setVisible(true); mC3.setVisible(true); mC4.setVisible(true); mC5.setVisible(true);
    decisionPanel.setVisible(true); decisionTitulo.setVisible(true); decisionValor.setVisible(true); decisionCriterio.setVisible(true); notaMetodologica.setVisible(true);
    tituloAnalisisDinamico.setVisible(false); subAnalisisDinamico.setVisible(false);
    tituloGrafInventario.setVisible(false); plotInventario.setVisible(false);
    tituloGrafFaltantes.setVisible(false); plotFaltantes.setVisible(false);
    tituloGrafServicio.setVisible(false); plotServicio.setVisible(false);
    tituloGrafUtilidad.setVisible(false); plotUtilidad.setVisible(false); notaGraficas.setVisible(false);
    vistaAnimacionActiva = false;
    panelAnimacion.setVisible(false); tituloAnimacion.setVisible(false); subAnimacion.setVisible(false); laneA.setVisible(false); rutaA.setVisible(false); clienteAnimA.setVisible(false); estadoA.setVisible(false); proveedorAnimA.setVisible(false); pedidoTxtA.setVisible(false); laneB.setVisible(false); rutaB.setVisible(false); clienteAnimB.setVisible(false); estadoB.setVisible(false); proveedorAnimB.setVisible(false); pedidoTxtB.setVisible(false); laneC.setVisible(false); rutaC.setVisible(false); clienteAnimC.setVisible(false); estadoC.setVisible(false); proveedorAnimC.setVisible(false); pedidoTxtC.setVisible(false);
}

diasSimulados++;
demandaDiaria = poisson(2.0);
demandaAcumulada += demandaDiaria;

// ======================= POLITICA A: s=5, Q=10 =======================
ventasDiaA = Math.min(stockA, demandaDiaria);
faltanteDiaA = demandaDiaria - ventasDiaA;
ventasPerdidasA += faltanteDiaA;
stockA -= ventasDiaA;
ingresosA += ventasDiaA * precioPromedioVenta;
costoVentasA += ventasDiaA * costoPromedioCompra;
costoAlmacenA += stockA * costoAlmacenDia;
costoFaltantesA += faltanteDiaA * costoVentaPerdida;
inventarioAcumuladoA += stockA;
inventarioPromedioA = inventarioAcumuladoA / diasSimulados;
if (demandaAcumulada > 0) nivelServicioA = 100.0 * (demandaAcumulada - ventasPerdidasA) / demandaAcumulada;
if (stockA <= puntoReordenA && !pedidoEnTransitoA) {
    pedidoEnTransitoA = true;
    pedidosRealizadosA++;
    costoPedidosA += costoPedido;
    tiempoEntregaA = triangular(3,5,7);
    recepcionPedidoA.restart(tiempoEntregaA, DAY);
}
utilidadA = ingresosA - costoVentasA - costoPedidosA - costoAlmacenA - costoFaltantesA;

// ======================= POLITICA B: s=8, Q=15 =======================
ventasDia = Math.min(stockActual, demandaDiaria);
ventaPerdidaDia = demandaDiaria - ventasDia;
ventasPerdidas += ventaPerdidaDia;
stockActual -= ventasDia;
ingresosAcum += ventasDia * precioPromedioVenta;
costoVentasAcum += ventasDia * costoPromedioCompra;
costoAlmacenAcum += stockActual * costoAlmacenDia;
costoFaltantesAcum += ventaPerdidaDia * costoVentaPerdida;
inventarioAcumulado += stockActual;
inventarioPromedio = inventarioAcumulado / diasSimulados;
if (demandaAcumulada > 0) nivelServicio = 100.0 * (demandaAcumulada - ventasPerdidas) / demandaAcumulada;
if (stockActual <= puntoReorden && !pedidoEnTransito) {
    pedidoEnTransito = true;
    pedidosRealizados++;
    costoPedidosAcum += costoPedido;
    tiempoEntregaUltimo = triangular(3,5,7);
    recepcionPedidoB.restart(tiempoEntregaUltimo, DAY);
}
utilidadNeta = ingresosAcum - costoVentasAcum - costoPedidosAcum - costoAlmacenAcum - costoFaltantesAcum;

// ======================= POLITICA C: s=12, Q=20 ======================
ventasDiaC = Math.min(stockC, demandaDiaria);
faltanteDiaC = demandaDiaria - ventasDiaC;
ventasPerdidasC += faltanteDiaC;
stockC -= ventasDiaC;
ingresosC += ventasDiaC * precioPromedioVenta;
costoVentasC += ventasDiaC * costoPromedioCompra;
costoAlmacenC += stockC * costoAlmacenDia;
costoFaltantesC += faltanteDiaC * costoVentaPerdida;
inventarioAcumuladoC += stockC;
inventarioPromedioC = inventarioAcumuladoC / diasSimulados;
if (demandaAcumulada > 0) nivelServicioC = 100.0 * (demandaAcumulada - ventasPerdidasC) / demandaAcumulada;
if (stockC <= puntoReordenC && !pedidoEnTransitoC) {
    pedidoEnTransitoC = true;
    pedidosRealizadosC++;
    costoPedidosC += costoPedido;
    tiempoEntregaC = triangular(3,5,7);
    recepcionPedidoC.restart(tiempoEntregaC, DAY);
}
utilidadC = ingresosC - costoVentasC - costoPedidosC - costoAlmacenC - costoFaltantesC;

// Seguimiento resumido cada 30 dias
if (diasSimulados % 30 == 0) {
    traceln("Dia " + diasSimulados + " | Demanda acum=" + demandaAcumulada
        + " | Servicio A=" + String.format("%.1f",nivelServicioA) + "%"
        + " | B=" + String.format("%.1f",nivelServicio) + "%"
        + " | C=" + String.format("%.1f",nivelServicioC) + "%");
}

// ======================= DECISION AL FINAL DEL ANO ===================
if (diasSimulados >= 365) {
    double mejor = -Double.MAX_VALUE;
    politicaRecomendada = "Sin politica >=95%; se elige mayor nivel de servicio";

    if (nivelServicioA >= 95.0 && utilidadA > mejor) { mejor = utilidadA; politicaRecomendada = "POLITICA A (s=5, Q=10)"; }
    if (nivelServicio >= 95.0 && utilidadNeta > mejor) { mejor = utilidadNeta; politicaRecomendada = "POLITICA B (s=8, Q=15)"; }
    if (nivelServicioC >= 95.0 && utilidadC > mejor) { mejor = utilidadC; politicaRecomendada = "POLITICA C (s=12, Q=20)"; }

    if (mejor == -Double.MAX_VALUE) {
        if (nivelServicioA >= nivelServicio && nivelServicioA >= nivelServicioC) politicaRecomendada = "POLITICA A (s=5, Q=10)";
        else if (nivelServicio >= nivelServicioC) politicaRecomendada = "POLITICA B (s=8, Q=15)";
        else politicaRecomendada = "POLITICA C (s=12, Q=20)";
    }

    traceln("====================================================");
    traceln("FIGUEROA SPORT - RESULTADOS DE 365 DIAS");
    traceln("Demanda total comun: " + demandaAcumulada);
    traceln("A | Servicio=" + String.format("%.2f",nivelServicioA) + "% | Perdidas=" + ventasPerdidasA + " | InvProm=" + String.format("%.2f",inventarioPromedioA) + " | Pedidos=" + pedidosRealizadosA + " | Utilidad=$" + String.format("%,.2f",utilidadA));
    traceln("B | Servicio=" + String.format("%.2f",nivelServicio) + "% | Perdidas=" + ventasPerdidas + " | InvProm=" + String.format("%.2f",inventarioPromedio) + " | Pedidos=" + pedidosRealizados + " | Utilidad=$" + String.format("%,.2f",utilidadNeta));
    traceln("C | Servicio=" + String.format("%.2f",nivelServicioC) + "% | Perdidas=" + ventasPerdidasC + " | InvProm=" + String.format("%.2f",inventarioPromedioC) + " | Pedidos=" + pedidosRealizadosC + " | Utilidad=$" + String.format("%,.2f",utilidadC));
    traceln("RECOMENDACION: " + politicaRecomendada);
    traceln("Criterio: " + criterioDecision);
    traceln("====================================================");
    finishSimulation();
}
]]></Action>
				</Event>
				<Event>
