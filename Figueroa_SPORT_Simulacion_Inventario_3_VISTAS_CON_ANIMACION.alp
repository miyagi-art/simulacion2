					<Action><![CDATA[// Animacion visual: representa la misma logica del modelo sin modificar resultados.
double fase = time() - Math.floor(time());
double xCliente = 110 + fase * 500;
clienteAnimA.setX(xCliente); clienteAnimB.setX(xCliente); clienteAnimC.setX(xCliente);
double xProv = 790 - fase * 150;
proveedorAnimA.setVisible(vistaAnimacionActiva && pedidoEnTransitoA);
proveedorAnimB.setVisible(vistaAnimacionActiva && pedidoEnTransito);
proveedorAnimC.setVisible(vistaAnimacionActiva && pedidoEnTransitoC);
if (pedidoEnTransitoA) proveedorAnimA.setX(xProv);
if (pedidoEnTransito) proveedorAnimB.setX(xProv);
if (pedidoEnTransitoC) proveedorAnimC.setX(xProv);]]></Action>
